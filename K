-- TAB 3: GRAPHICS BOOST
local Tab3 = Window:Tab({
    Title = "Graphics",
    Icon = "zap",
    Locked = false,
})

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local original = {
    FogStart = Lighting.FogStart,
    FogEnd = Lighting.FogEnd,
    GlobalShadows = Lighting.GlobalShadows,
    Brightness = Lighting.Brightness,
    Ambient = Lighting.Ambient,
    OutdoorAmbient = Lighting.OutdoorAmbient,
}

local fogEnabled = false
local lightEnabled = false
local fpsEnabled = false

-- ลบหมอก
Tab3:Toggle({
    Title = "Remove Fog",
    Default = false,
    Callback = function(state)
        fogEnabled = state

        if state then
            Lighting.FogStart = 0
            Lighting.FogEnd = 1000000

            for _, obj in ipairs(Lighting:GetChildren()) do
                if obj:IsA("Atmosphere") then
                    obj:SetAttribute(
                        "GraphicsOriginalDensity",
                        obj.Density
                    )
                    obj:SetAttribute(
                        "GraphicsOriginalHaze",
                        obj.Haze
                    )
                    obj.Density = 0
                    obj.Haze = 0
                end
            end
        else
            Lighting.FogStart = original.FogStart
            Lighting.FogEnd = original.FogEnd

            for _, obj in ipairs(Lighting:GetChildren()) do
                if obj:IsA("Atmosphere") then
                    local density = obj:GetAttribute(
                        "GraphicsOriginalDensity"
                    )
                    local haze = obj:GetAttribute(
                        "GraphicsOriginalHaze"
                    )

                    if density ~= nil then
                        obj.Density = density
                        obj:SetAttribute(
                            "GraphicsOriginalDensity", nil
                        )
                    end

                    if haze ~= nil then
                        obj.Haze = haze
                        obj:SetAttribute(
                            "GraphicsOriginalHaze", nil
                        )
                    end
                end
            end
        end
    end
})

-- เพิ่มแสง
Tab3:Toggle({
    Title = "Extra Brightness",
    Default = false,
    Callback = function(state)
        lightEnabled = state

        if state then
            Lighting.Brightness = 3
            Lighting.GlobalShadows = false
            Lighting.Ambient = Color3.fromRGB(190, 190, 190)
            Lighting.OutdoorAmbient = Color3.fromRGB(210, 210, 210)
        else
            Lighting.Brightness = original.Brightness
            Lighting.GlobalShadows = original.GlobalShadows
            Lighting.Ambient = original.Ambient
            Lighting.OutdoorAmbient = original.OutdoorAmbient
        end
    end
})

-- ลดรายละเอียดเอฟเฟกต์เพื่อช่วย FPS
Tab3:Toggle({
    Title = "FPS Boost",
    Default = false,
    Callback = function(state)
        fpsEnabled = state

        if state then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") then
                    obj.Material = Enum.Material.Plastic
                elseif obj:IsA("ParticleEmitter")
                    or obj:IsA("Trail")
                    or obj:IsA("Smoke")
                    or obj:IsA("Fire")
                    or obj:IsA("Sparkles") then
                    obj.Enabled = false
                end
            end

            Lighting.GlobalShadows = false
            Lighting.Brightness = 2
        else
            -- คืนค่าแสงพื้นฐาน
            Lighting.Brightness = original.Brightness
            Lighting.GlobalShadows = original.GlobalShadows
        end
    end
})
