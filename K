-- ESP configuration
local Config = {
    Monster = true,
    Machine = true,
    Item = true,
}

local Colors = {
    Monster = Color3.fromRGB(255, 40, 55),
    Machine = Color3.fromRGB(0, 190, 255),
    Item = Color3.fromRGB(255, 255, 255),
}

local Highlights = {}

local function matches(name, names)
    for _, target in ipairs(names) do
        if name == target then
            return true
        end
    end
    return false
end

local function getType(obj)
    if not obj:IsA("Model") then
        if obj:IsA("BasePart") then
            if matches(obj.Name, MachineNames) then
                return "Machine"
            end

            if matches(obj.Name, ItemNames) then
                return "Item"
            end
        end

        return nil
    end

    if Players:GetPlayerFromCharacter(obj) then
        return nil
    end

    if matches(obj.Name, MachineNames) then
        return "Machine"
    end

    if matches(obj.Name, ItemNames) then
        return "Item"
    end

    if obj:FindFirstChildOfClass("Humanoid") then
        return "Monster"
    end

    return nil
end

local function addESP(obj)
    local kind = getType(obj)

    if not kind or Highlights[obj] then
        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "WindUI_ESP"
    highlight.Adornee = obj
    highlight.FillTransparency = 1
    highlight.OutlineTransparency = 0
    highlight.OutlineColor = Colors[kind]
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = Config[kind]
    highlight.Parent = Workspace

    Highlights[obj] = highlight
end

local function setESP(kind, enabled)
    Config[kind] = enabled

    for obj, highlight in pairs(Highlights) do
        if highlight.Parent and obj.Parent then
            if getType(obj) == kind then
                highlight.Enabled = enabled
            end
        end
    end

    if enabled then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            addESP(obj)
        end
    end
end

local function scan()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        addESP(obj)
    end
end

Workspace.DescendantAdded:Connect(function(obj)
    task.wait(0.2)

    if obj.Parent then
        addESP(obj)
    end
end)

Workspace.DescendantRemoving:Connect(function(obj)
    local highlight = Highlights[obj]

    if highlight then
        highlight:Destroy()
        Highlights[obj] = nil
    end
end)

-- Initial scan
scan()

